# Copy to .env and adjust. Every value has a working default; the app runs in
# demo mode (synthetic scans, SQLite, local blobs) with no configuration at all.

# --- Cloudflare URL Scanner v2 ---
# Leave CF_API_TOKEN/CF_ACCOUNT_ID empty (or set CF_FAKE=true) to use the offline
# synthetic scanner. Provide both to scan real URLs.
#   Token: create a custom API token with the "Account > URL Scanner: Edit" permission.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_FAKE=false
CF_VISIBILITY=Unlisted
# CF_API_BASE=https://api.cloudflare.com/client/v4

# --- Database (SQLAlchemy async URL) ---
# SQLite (default, local-first):
DATABASE_URL=sqlite+aiosqlite:///./data/domainsentinel.db
# Postgres (Cloud SQL) example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/domainsentinel

# --- Blob storage (screenshots, DOM, HAR, diff images) ---
BLOB_BACKEND=local            # local | gcs
BLOB_LOCAL_DIR=./data/blobs
# GCS_BUCKET=my-domainsentinel-bucket
# GCS_PREFIX=domainsentinel

# --- Scanning / scheduling ---
DEFAULT_SCAN_INTERVAL_HOURS=24
SCREENSHOT_RESOLUTIONS=desktop   # comma separated: desktop,mobile,tablet
SCAN_POLL_TIMEOUT_SECONDS=180
SCAN_POLL_INTERVAL_SECONDS=10
# In-process scheduler. Set false on Cloud Run if you drive /api/cron/tick from
# Cloud Scheduler instead (recommended with >1 instance).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- Security ---
# If set, POST /api/cron/tick requires header  X-Cron-Secret: <value>
CRON_SECRET=

# --- Server ---
PORT=8080
# CORS_ORIGINS=*
# STATIC_DIR=   # auto-detects ../frontend/dist locally; set to /app/static in Docker
